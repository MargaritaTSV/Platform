{
  "color": {
    "bg": "#FDFCFA",
    "ink": "#161616",
    "muted": "#6F6B64",
    "faint": "#9A958C",
    "rule": "#BDB7AB",
    "rule-light": "#D9D5CC",
    "hover": "#3B6E99",
    "scan-bg": "#F5F3EE",
    "wavy-underline": "#A9B9C7"
  },
  "font": {
    "serif": "'Cormorant Garamond', Georgia, serif",
    "sans": "'Onest', system-ui, sans-serif",
    "mono": "'JetBrains Mono', monospace",
    "google-fonts-url": "https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=Onest:wght@300;400;500&family=JetBrains+Mono:wght@400&display=swap"
  },
  "type": {
    "logo": {
      "font": "serif",
      "size": 30,
      "style": "italic",
      "weight": 500
    },
    "page-title": {
      "font": "serif",
      "size": 64,
      "weight": 400,
      "note": "one word in italic"
    },
    "problems-title": {
      "font": "serif",
      "size": 80,
      "weight": 400,
      "lineHeight": 0.95
    },
    "area-name": {
      "font": "serif",
      "size": 56,
      "weight": 400,
      "lineHeight": 0.98
    },
    "star-label": {
      "font": "serif",
      "size": 23,
      "weight": 500,
      "selected": "italic"
    },
    "subtopic-row": {
      "font": "serif",
      "size": 32,
      "weight": 500
    },
    "filter-sentence": {
      "font": "serif",
      "size": 28,
      "weight": 400,
      "lineHeight": 1.6
    },
    "problem-number": {
      "font": "serif",
      "size": 56,
      "weight": 400,
      "lineHeight": 0.8
    },
    "problem-statement": {
      "font": "serif",
      "size": 25,
      "weight": 500,
      "lineHeight": 1.45
    },
    "games-title": {
      "font": "serif",
      "size": 52,
      "weight": 400
    },
    "game-name": {
      "font": "serif",
      "size": 40,
      "weight": 500
    },
    "body": {
      "font": "sans",
      "size": 15,
      "weight": 400,
      "lineHeight": 1.7
    },
    "nav": {
      "font": "sans",
      "size": 14,
      "weight": 400
    },
    "search": {
      "font": "sans",
      "size": 17,
      "weight": 300
    },
    "label": {
      "font": "mono",
      "size": 12,
      "weight": 400
    }
  },
  "layout": {
    "content-max-width": 1088,
    "page-padding-x": 64,
    "section-gap": [
      72,
      96
    ],
    "problem-row-padding": [
      40,
      44
    ],
    "problem-columns": "112px 1fr",
    "subtopic-row-columns": "40px 300px 1fr 60px",
    "topic-block-columns": "300px 1fr",
    "rail-width": [
      220,
      250
    ]
  },
  "line": {
    "divider-stroke": 1.1,
    "rule-stroke": 1,
    "ring-stroke": 1.3,
    "note": "all lines are drawn SVG paths with a slight wobble; never CSS borders or <hr>"
  }
}
